---
/**
 * Drop-in subscribe form for emdash-newsletter.
 *
 *   import SubscribeForm from "emdash-newsletter/components/SubscribeForm.astro";
 *   <SubscribeForm source="footer" />
 *
 * Works without JavaScript (posts and shows the newsletter's result page) and
 * enhances to an inline message when JS is on. Style it with the CSS custom
 * properties below, or target the `.nl-subscribe` classes.
 */
interface Props {
	/** Where the newsletter routes are mounted. Default /newsletter. */
	basePath?: string;
	/** Recorded on the subscriber, e.g. "footer" or "homepage". */
	source?: string;
	heading?: string;
	text?: string;
	buttonLabel?: string;
	placeholder?: string;
	/** Ask for a first name too. */
	askName?: boolean;
	/** Topic slugs to subscribe to (hidden fields). Empty = the default topics. */
	topics?: string[];
	/** Cloudflare Turnstile site key. Requires the Turnstile secret in the newsletter settings. */
	turnstileSiteKey?: string;
	/** Page to return to after a no-JS submit (same site). */
	redirect?: string;
	class?: string;
}

const {
	basePath = "/newsletter",
	source = "website",
	heading,
	text,
	buttonLabel = "Subscribe",
	placeholder = "you@example.com",
	askName = false,
	topics = [],
	turnstileSiteKey,
	redirect,
	class: className,
} = Astro.props;

const action = `${basePath.replace(/\/$/, "")}/subscribe`;
const id = `nl-${Math.random().toString(36).slice(2, 8)}`;
---

<form class:list={["nl-subscribe", className]} method="post" action={action} data-nl-subscribe aria-labelledby={heading ? `${id}-h` : undefined}>
	{heading && <h2 id={`${id}-h`} class="nl-subscribe__heading">{heading}</h2>}
	{text && <p class="nl-subscribe__text">{text}</p>}
	<div class="nl-subscribe__row">
		{
			askName && (
				<>
					<label for={`${id}-name`} class="nl-sr-only">First name</label>
					<input id={`${id}-name`} class="nl-subscribe__input" type="text" name="first_name" autocomplete="given-name" placeholder="First name" />
				</>
			)
		}
		<label for={`${id}-email`} class="nl-sr-only">Email address</label>
		<input id={`${id}-email`} class="nl-subscribe__input" type="email" name="email" required autocomplete="email" placeholder={placeholder} />
		<button type="submit" class="nl-subscribe__button">{buttonLabel}</button>
	</div>
	<input type="hidden" name="source" value={source} />
	{topics.map((t) => <input type="hidden" name="topics" value={t} />)}
	{redirect && <input type="hidden" name="redirect" value={redirect} />}
	<!-- Honeypot: people never see or fill this. -->
	<div class="nl-sr-only" aria-hidden="true">
		<label>Leave empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
	</div>
	{turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-size="flexible"></div>}
	<p class="nl-subscribe__status" role="status" aria-live="polite"></p>
</form>
{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
	for (const form of document.querySelectorAll<HTMLFormElement>("[data-nl-subscribe]")) {
		if (form.dataset.nlReady) continue;
		form.dataset.nlReady = "1";
		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			const status = form.querySelector<HTMLElement>(".nl-subscribe__status");
			const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
			if (button) button.disabled = true;
			if (status) status.textContent = "Subscribing…";
			try {
				const res = await fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
				const data = (await res.json()) as { ok: boolean; message: string };
				if (status) status.textContent = data.message;
				form.dataset.state = data.ok ? "success" : "error";
				if (data.ok) form.reset();
			} catch {
				if (status) status.textContent = "Something went wrong. Please try again.";
				form.dataset.state = "error";
			} finally {
				if (button) button.disabled = false;
				(window as unknown as { turnstile?: { reset(): void } }).turnstile?.reset();
			}
		});
	}
</script>

<style>
	.nl-subscribe {
		--nl-accent: var(--color-brand, #4f3cc9);
		--nl-radius: 999px;
		--nl-border: color-mix(in srgb, currentColor 25%, transparent);
		display: grid;
		gap: 0.75rem;
		max-width: 36rem;
	}
	.nl-subscribe__heading {
		margin: 0;
		font-size: 1.25rem;
	}
	.nl-subscribe__text {
		margin: 0;
		opacity: 0.8;
	}
	.nl-subscribe__row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.nl-subscribe__input {
		flex: 1 1 12rem;
		min-width: 0;
		font: inherit;
		padding: 0.65rem 1rem;
		border-radius: var(--nl-radius);
		border: 1px solid var(--nl-border);
		background: transparent;
		color: inherit;
	}
	.nl-subscribe__input:focus-visible,
	.nl-subscribe__button:focus-visible {
		outline: 3px solid color-mix(in srgb, var(--nl-accent) 45%, transparent);
		outline-offset: 1px;
	}
	.nl-subscribe__button {
		font: inherit;
		font-weight: 600;
		padding: 0.65rem 1.25rem;
		border: 0;
		border-radius: var(--nl-radius);
		background: var(--nl-accent);
		color: #fff;
		cursor: pointer;
	}
	.nl-subscribe__button:disabled {
		opacity: 0.6;
		cursor: progress;
	}
	.nl-subscribe__status {
		margin: 0;
		min-height: 1.4em;
		font-size: 0.9rem;
	}
	.nl-subscribe[data-state="error"] .nl-subscribe__status {
		color: #b42318;
	}
	.nl-sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>
